rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions keamanan bersama
    function isKasir() {
      return request.auth != null;
    }

    // =========================================================================
    // 1. ATURAN KOLEKSI ROOT (Default & Kompatibilitas)
    // =========================================================================

    match /resto_menu/{menuId} {
      allow read: if true;
      allow write: if isKasir();
    }

    match /resto_config/{configId} {
      allow read: if true;
      allow write: if isKasir();
    }
    match /resto_settings/{settingId} {
      allow read: if true;
      allow write: if isKasir();
    }

    match /table_orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.tableNo is string
                    && request.resource.data.customerName is string
                    && request.resource.data.totalAmount > 0
                    && request.resource.data.items is list;
      allow update: if isKasir()
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
                        && request.resource.data.paymentStatus == 'waiting_verification');
      allow delete: if isKasir();
    }

    match /table_calls/{callId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.tableNo is string;
      allow update, delete: if isKasir();
    }

    // =========================================================================
    // 2. ATURAN MULTI-TENANT ISOLASI RESTORAN (/restos/{restoId}/...)
    // =========================================================================

    match /restos/{restoId} {
      allow read: if true;
      allow write: if isKasir();

      match /resto_menu/{menuId} {
        allow read: if true;
        allow write: if isKasir();
      }

      match /resto_config/{configId} {
        allow read: if true;
        allow write: if isKasir();
      }
      match /resto_settings/{settingId} {
        allow read: if true;
        allow write: if isKasir();
      }

      match /table_orders/{orderId} {
        allow read: if true;
        allow create: if request.resource.data.status == 'pending'
                      && request.resource.data.tableNo is string
                      && request.resource.data.customerName is string
                      && request.resource.data.totalAmount > 0
                      && request.resource.data.items is list;
        allow update: if isKasir()
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
                          && request.resource.data.paymentStatus == 'waiting_verification');
        allow delete: if isKasir();
      }

      match /table_calls/{callId} {
        allow read: if true;
        allow create: if request.resource.data.status == 'pending'
                      && request.resource.data.tableNo is string;
        allow update, delete: if isKasir();
      }
    }
  }
}
