# Port tempat backend API berjalan
PORT=3001

# Lingkungan aplikasi (development / production)
NODE_ENV=production

# Izin Domain CORS (Gunakan * untuk mengizinkan semua domain web pemesanan dan kasir)
CORS_ORIGIN=*

# Kunci rahasia untuk administrasi backend
ADMIN_SECRET_KEY=mini-resto-secret-key-2026
